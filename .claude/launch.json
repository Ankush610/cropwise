{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "project/api.py"
      ],
      "port": 8000
    },
    {
      "name": "demo",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": [
